# =============================================================================
# Jarvis – environment variables
# Copy this file to `.env` and fill in the values you need.
# Anything marked (optional) can be left blank; the agent will skip the related
# tool / feature at runtime.
# =============================================================================

# ----- Model (required) ------------------------------------------------------
# Anthropic API key used by the default Jarvis agent (Claude Opus 5).
ANTHROPIC_API_KEY=

# Override the default model. Format: "<provider>:<model-id>".
# Defaults to "anthropic:claude-opus-5". Examples:
#   anthropic:claude-opus-5
#   anthropic:claude-sonnet-5
JARVIS_MODEL=anthropic:claude-opus-5

# Thinking depth / token spend: low | medium | high | xhigh | max.
# Unset = API default (high). Opus 5 thinks adaptively, so simple turns are
# quick either way; lower mainly trims cost on routine traffic.
# JARVIS_EFFORT=

# Opus fast mode (~2.5x faster output, 2x token price). Needs fast-mode rate
# limits on the Anthropic org; requests fail with 429 otherwise.
# JARVIS_FAST_MODE=false

# Server-side refusal fallbacks on Opus 5 / Fable: if a safety classifier
# declines a request, it is retried on a fallback model instead of failing.
# JARVIS_REFUSAL_FALLBACK=true

# Optional sampling temperature. Leave UNSET for newer Claude models
# (Opus 4.7+ / Sonnet 5+) — they reject temperature/top_p/top_k with HTTP 400.
# Only set this for older models that still accept sampling params.
# JARVIS_TEMPERATURE=0

# ----- Tools (optional) ------------------------------------------------------
# Tavily: `internet_search` (quick) + `tavily_deep_research` (pro model, slower). Without this key both are disabled.
TAVILY_API_KEY=

# ----- Composio (optional) ---------------------------------------------------
# https://composio.dev unified tool platform. Used by Jarvis to access
# pre-built integrations (Shopify, Gmail, GitHub, …). Without this key the
# Composio toolkits declared on each agent are skipped with a warning.
COMPOSIO_API_KEY=

# Composio user id. Every Composio call is scoped to a user; use "default" for
# a single-tenant setup, or a real user id when running multi-user.
COMPOSIO_USER_ID=default

# ----- Sandbox (shell + skill scripts) -------------------------------------
# Gives agents the `execute` tool. See docs/DEVELOPMENT.md#sandbox.
#   local = bubblewrap-isolated shell on this machine (default; free).
#           One-time host setup: `sudo bash scripts/setup-sandbox.sh`.
#   deno  = Deno Deploy sandbox (paid plan), falling back to local.
#   none  = no shell.
JARVIS_SANDBOX_PROVIDER=local

# Local sandbox state: <dir>/home → /home/app, <dir>/tmp → /tmp,
# <dir>/tools → preinstalled Python venv + node_modules.
# JARVIS_SANDBOX_DIR=.sandbox
# Per-command time limit (seconds), output cap, max single-file size.
# JARVIS_SANDBOX_EXEC_TIMEOUT_SEC=300
# JARVIS_SANDBOX_MAX_OUTPUT_BYTES=60000
# JARVIS_SANDBOX_MAX_FILE_MB=512
# Outbound network from inside the sandbox (pip install, curl, APIs).
# JARVIS_SANDBOX_NETWORK=true
# Commands allowed to run at once.
# JARVIS_SANDBOX_MAX_CONCURRENCY=2

# Deno provider only. Org tokens start with `ddo_`; personal tokens (`ddp_`)
# also need DENO_DEPLOY_ORG.
# DENO_DEPLOY_TOKEN=
# DENO_DEPLOY_ORG=
# JARVIS_SANDBOX_TIMEOUT=session
# JARVIS_SANDBOX_MEMORY=1GiB

# ----- Scandi data APIs (optional; powers the scandi-* skills) --------------
# These never enter the sandbox. Jarvis runs a localhost "kit gateway" that
# attaches them to requests from sandboxed kit scripts and refuses writes.
# Each service switches on when its credentials are present.
# Shopify Admin (OAuth client_credentials app)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_API_VERSION=2026-01
# Skio subscriptions
SKIO_API_KEY=
# Meta Marketing API
META_APP_TOKEN=
# META_API_VERSION=v25.0
META_AD_ACCOUNT_IDS=
# Our dashboard API (read-only key)
PROFIT_API_BASE=
PROFIT_API_KEY=
# Triple Whale (Google + TikTok spend)
TRIPLEWHALE_API_KEY=
# Let the gateway pass writes (mutations / non-GET). Leave false.
# JARVIS_KIT_ALLOW_WRITES=false

# Working context budget; long conversations are compacted near 85% of it.
# JARVIS_CONTEXT_WINDOW_TOKENS=300000

# ----- Observability (optional, recommended) ---------------------------------
# Uncomment to enable LangSmith tracing of every run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=scandi-jarvis

# ----- WhatsApp frontend (optional; required to run `npm run wa:server`) -----
# Base URL of the scandi-wa-bot HTTP API (no trailing slash).
WA_BOT_BASE_URL=http://127.0.0.1:8787
# Bearer token configured as API_AUTH_TOKEN on the WA bot.
WA_BOT_TOKEN=
# Shared secret returned by `POST /v1/webhooks` when registering this app
# as a subscriber. Used to verify HMAC-SHA256 signatures on webhook deliveries.
WA_WEBHOOK_SECRET=

# WHO MAY USE JARVIS. Both gates are checked before any run starts; anything
# from anyone else is dropped (no reply, no reaction, no LLM call).
#
# The people: phone numbers and/or LIDs, comma-separated. Applies to DMs and
# to messages inside allowed groups. Empty = nobody (fail closed), "*" = anyone
# (local dev only — Jarvis reads live business data).
JARVIS_WA_ALLOWED_SENDERS=
#
# The groups Jarvis participates in (group JIDs). DMs from allowed senders
# work without being listed here.
# - Empty / unset (default) = no groups.
# - "*" = allow all groups (local dev only).
# - comma-separated list, e.g.
#     JARVIS_WA_ALLOWED_CHATS=120363012345678901@g.us
JARVIS_WA_ALLOWED_CHATS=

# Fastify bind. Defaults to 127.0.0.1:3000 — terminate TLS at a reverse proxy.
JARVIS_WA_HOST=127.0.0.1
JARVIS_WA_PORT=3000

# Quiet-window before triggering a run after the last inbound message arrives
# (resets on every new message in the same chat). Default 2.5s.
JARVIS_WA_DEBOUNCE_MS=2500

# Agent sessions: a chat's runs share one prompt-cached thread until the chat
# has been idle this many minutes or the thread has served this many runs.
# JARVIS_WA_SESSION_IDLE_MIN=45
# JARVIS_WA_SESSION_MAX_RUNS=15

# Summaries refresh in the background once a chat is quiet this long (ms).
# JARVIS_SUMMARY_IDLE_MS=120000

# Max time to wait for `message.processed` on media before proceeding without
# the AI summary. Default 60s.
JARVIS_WA_MEDIA_WAIT_MS=60000

# How many recent messages to include in the context block per turn.
JARVIS_WA_CONTEXT_MSGS=30

# Model used for chat summarisation (daily / weekly / long-term).
JARVIS_SUMMARY_MODEL=anthropic:claude-sonnet-5

# Per-run hard caps on outbound WA tool calls (prevents runaway agents).
JARVIS_WA_MAX_SENDS_PER_RUN=8
JARVIS_WA_MIN_SEND_INTERVAL_MS=500

# Show "typing…" in the chat for the lifetime of a run. The wa-bot refreshes
# the WhatsApp chatstate itself and drops it as soon as a message is sent;
# Jarvis only opens the session, re-asserts it on the keepalive interval, and
# closes it when the run ends.
JARVIS_WA_TYPING_ENABLED=true
# How often we re-assert the session (must stay well under the TTL below).
JARVIS_WA_TYPING_KEEPALIVE_MS=40000
# Lifetime we ask the bot to hold the indicator for. If Jarvis dies mid-run,
# the bot stops typing once this lapses.
JARVIS_WA_TYPING_TTL_MS=120000
#
# Read receipts need no config here — the wa-bot acks every live inbound
# message on its own (see READ_RECEIPTS_* in the bot's .env).

# Postgres connection string. Used by:
#   - jarvis.chat_context (summaries + AGENTS.md-style notes)
#   - jarvis.wa_webhook_seen (webhook idempotency)
#   - @langchain/langgraph-checkpoint-postgres (per-chat thread checkpoints)
# Hosted Supabase Postgres works (use the "Connection pooler" string for
# transactions if your runtime opens many connections).
SUPABASE_DB_URL=

# ----- Workflows (optional) --------------------------------------------------
# Deterministic scheduled tasks that run independently of the chat agent and
# report results back via the WhatsApp REST API.
# See docs/WORKFLOWS.md for how to add a new one.

# Default destination chat for workflow notifications. Workflows can override
# this individually (e.g. WORKFLOW_REVOLUT_CHAT_JID below).
JARVIS_WORKFLOWS_DEFAULT_CHAT_JID=

# Revolut expenses API — required for the `revolut-daily-expenses` workflow.
# Base URL of the scandi-revolut-expenses HTTP API (no trailing slash).
REVOLUT_EXPENSES_API_BASE_URL=
REVOLUT_EXPENSES_API_KEY=
# Optional per-workflow chat override; falls back to the default above.
WORKFLOW_REVOLUT_CHAT_JID=

# ----- Runtime (optional) ----------------------------------------------------
# debug | info | warn | error  (default: info)
LOG_LEVEL=info
